{
  "name": "bad-apple-studio",
  "version": "1.0.0",
  "description": "Run entirely locally: Upload video → Backend converts/compresses into 1-bit frame data → Compile firmware based on chosen display (0.96\" SSD1306 or 1.3\" SH1106) → Generate LittleFS image → Web flasher interface (esp-web-tools) flashes directly via USB.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.badapplestudio.app",
    "productName": "Bad Apple Studio",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload-picker.js",
      "port-picker.html",
      "backend/**/*",
      "web/**/*",
      "firmware/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minta1234/bad-apple-studio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Minta1234/bad-apple-studio/issues"
  },
  "homepage": "https://github.com/Minta1234/bad-apple-studio#readme",
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  }
}
